{%- assign root_id = 'TmCat-' | append: section.id -%}

{%- capture category_fallback_titles -%}Fibre Trophy;Metal Corporate Awards;Wooden Memento;Medals;Badges{%- endcapture -%}
{%- assign category_fallback_items = category_fallback_titles | split: ';' -%}

<div class="tm-root" id="{{ root_id }}" data-tm-cats>
  <section id="collections" class="relative overflow-hidden bg-white border-b border-[#E8E4DA] py-16 sm:py-20">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-8 sm:mb-10">
        <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-[#0E233E] tracking-tight leading-[1.02] lg:whitespace-nowrap">
          Shopping <span class="italic text-[#C5222A]">by Category</span>
        </h2>

        <div class="flex shrink-0 gap-3">
          <button type="button" data-tm-cat-prev aria-label="Previous categories"
            class="w-10 h-10 sm:w-11 sm:h-11 border border-[#0E233E]/25 bg-white flex items-center justify-center text-[#0E233E] transition-colors hover:bg-[#0E233E] hover:text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
          </button>
          <button type="button" data-tm-cat-next aria-label="Next categories"
            class="w-10 h-10 sm:w-11 sm:h-11 border border-[#0E233E]/25 bg-white flex items-center justify-center text-[#0E233E] transition-colors hover:bg-[#0E233E] hover:text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </button>
        </div>
      </div>

      <!-- Carousel -->
      <div class="no-scrollbar flex gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory py-2 -my-2" data-tm-track>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.title != blank or block.settings.image != blank -%}
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" data-card
                class="snap-start shrink-0 w-[78%] sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.834rem)] xl:w-[calc(25%-0.9375rem)] cursor-pointer bg-[#070D18] border border-white/10 p-5 sm:p-6 flex flex-col items-center gap-5 transition-transform duration-300 hover:-translate-y-1"
                {{ block.shopify_attributes }}>
                <div class="relative aspect-square w-full max-w-[210px] rounded-full overflow-hidden bg-[#F4F1EA]">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 480 }}" alt="{{ block.settings.title | escape }}" loading="lazy" decoding="async" class="h-full w-full object-cover">
                  {%- else -%}
                    <span class="h-full w-full flex items-center justify-center">
                      <svg viewBox="0 0 24 24" fill="none" stroke="#B98A2E" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="w-1/2 h-1/2" aria-hidden="true"><path d="M8 21h8"></path><path d="M12 21v-6"></path><path d="M7 3h10v6a5 5 0 0 1-10 0V3Z"></path><path d="M7 5H4v2a3 3 0 0 0 3 3"></path><path d="M17 5h3v2a3 3 0 0 1-3 3"></path></svg>
                    </span>
                  {%- endif -%}
                </div>
                <h3 class="text-center text-base sm:text-lg font-medium text-white leading-snug">{{ block.settings.title }}</h3>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for title in category_fallback_items -%}
            <a href="{{ routes.search_url }}?q={{ title | url_encode }}&amp;type=product" data-card
              class="snap-start shrink-0 w-[78%] sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.834rem)] xl:w-[calc(25%-0.9375rem)] cursor-pointer bg-[#070D18] border border-white/10 p-5 sm:p-6 flex flex-col items-center gap-5 transition-transform duration-300 hover:-translate-y-1">
              <div class="relative aspect-square w-full max-w-[210px] rounded-full overflow-hidden bg-[#F4F1EA]">
                <span class="h-full w-full flex items-center justify-center">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#B98A2E" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="w-1/2 h-1/2" aria-hidden="true"><path d="M8 21h8"></path><path d="M12 21v-6"></path><path d="M7 3h10v6a5 5 0 0 1-10 0V3Z"></path><path d="M7 5H4v2a3 3 0 0 0 3 3"></path><path d="M17 5h3v2a3 3 0 0 1-3 3"></path></svg>
                </span>
              </div>
              <h3 class="text-center text-base sm:text-lg font-medium text-white leading-snug">{{ title }}</h3>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

<script>
(function () {
  'use strict';

  var AUTO_MS = 3500;
  var registry = [];

  function attachTrack(root, track) {
    var paused = false;
    var visible = true;
    var timer = null;

    function step() {
      var card = track.querySelector('[data-card]') || track.firstElementChild;
      var gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
      return card ? card.offsetWidth + gap : track.clientWidth * 0.8;
    }

    function advance() {
      if (paused || !visible) return;
      var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      track.scrollTo({ left: atEnd ? 0 : track.scrollLeft + step(), behavior: 'smooth' });
    }

    function scrollByCard(direction) {
      track.scrollBy({ left: direction * step(), behavior: 'smooth' });
    }

    var prev = root.querySelector('[data-tm-cat-prev]');
    var next = root.querySelector('[data-tm-cat-next]');
    if (prev) prev.addEventListener('click', function () { scrollByCard(-1); });
    if (next) next.addEventListener('click', function () { scrollByCard(1); });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    timer = window.setInterval(advance, AUTO_MS);
    registry.push({ root: root, timer: timer, track: track });

    track.addEventListener('pointerenter', function () { paused = true; });
    track.addEventListener('pointerleave', function () { paused = false; });
    track.addEventListener('touchstart', function () { paused = true; }, { passive: true });
    track.addEventListener('touchend', function () { paused = false; });

    if (typeof IntersectionObserver !== 'undefined') {
      var observer = new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting;
      }, { threshold: 0.25 });
      observer.observe(track);
      registry.push({ root: root, timer: null, observer: observer });
    }
  }

  function initRoot(root) {
    if (root.getAttribute('data-tm-init') === '1') return;
    root.setAttribute('data-tm-init', '1');
    var track = root.querySelector('[data-tm-track]');
    if (track) attachTrack(root, track);
  }

  function initAll() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-tm-cats]'), initRoot);
  }

  document.addEventListener('shopify:section:load', function (e) {
    var root = document.getElementById('TmCat-' + e.detail.sectionId);
    if (root) initRoot(root);
  });

  document.addEventListener('shopify:section:unload', function (e) {
    var id = 'TmCat-' + e.detail.sectionId;
    registry = registry.filter(function (entry) {
      if (entry.root.id === id || !entry.root.isConnected) {
        if (entry.timer) window.clearInterval(entry.timer);
        if (entry.observer) entry.observer.disconnect();
        return false;
      }
      return true;
    });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>

{% schema %}
{
  "name": "Trophy Mart Category Showcase",
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Category card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (shown in the round frame)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Trophy Mart Category Showcase"
    }
  ]
}
{% endschema %}
