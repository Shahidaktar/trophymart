{%- assign root_id = 'TmFaq-' | append: section.id -%}

{%- capture faq_fallback -%}
Can I customize trophies with our company logo and individual recipient names?~Absolutely. Every trophy, plaque, and medal we produce can be customized with high-resolution vector logos, personalized recipient names, designation titles, and event dates. We support laser surface etching, 3D sub-surface laser crystal engraving, direct full-color UV cure printing, and diamond-drag metal marking.;
How fast can you deliver urgent bulk orders across India?~We manufacture and assemble in-house, eliminating middleman delays. In-stock catalog awards with custom engraving are dispatched in 24 to 48 hours. Custom sculpted or cast awards typically require 3 to 5 working days. We ship via express air cargo with real-time tracking to 66+ cities nationwide.;
What materials do you specialize in?~Our state-of-the-art facility crafts in premium optical K9 crystal, imported cast acrylic, 24k electroplated brass and bronze, sculptural fiber-resin composites, and natural hand-buffed hardwoods (such as African Mahogany and American Walnut).;
Can we receive a digital 3D proof or sample before placing a volume order?~Yes. Before manufacturing commences on custom awards, our senior design team renders a detailed 2D/3D digital visual proof showing precise dimensions, typography placement, and logo alignment for your team's formal sign-off.;
Are there wholesale volume discounts for corporate and tournament bulk orders?~Yes. As a direct factory manufacturer, we offer tiered volume pricing starting from 10 units up to 10,000+ units. Discounts range from 12% to over 40% off standard catalog rates. You can request a tailored GST quotation through our Bulk Quotation tool.
{%- endcapture -%}
{%- assign faq_fallback_items = faq_fallback | split: ';' -%}

<div class="tm-root" id="{{ root_id }}" data-tm-faq>
  <section class="py-20 bg-white border-b border-[#E8E4DA]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="mb-12 sm:mb-16">
        <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-[#0E233E] mt-4 leading-[1.02] tracking-tight lg:whitespace-nowrap">
          Frequently Asked
          <span class="italic text-[#C5222A]">Questions</span>
        </h2>
      </div>

      <!-- Accordion List -->
      <div class="space-y-3.5">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.question != blank -%}
              <div class="border border-[#E5E0D4] overflow-hidden transition-all duration-200" data-tm-faq-item {{ block.shopify_attributes }}>
                <button type="button" data-tm-faq-q
                  class="w-full p-4 sm:p-5 text-left bg-[#FAF9F5] hover:bg-[#F3F0E8] transition-colors flex items-center justify-between gap-4">
                  <span class="font-serif text-base sm:text-lg font-bold text-[#0E233E]">{{ block.settings.question }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-tm-faq-icon
                    class="w-4 h-4 text-[#0E233E] shrink-0 transition-transform duration-200 {% if forloop.first %}rotate-180 text-[#C5222A]{% endif %}" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                </button>
                <div data-tm-faq-a class="p-4 sm:p-5 bg-white text-xs sm:text-sm text-[#475569] leading-relaxed border-t border-[#E8E4DA]" {% unless forloop.first %}hidden{% endunless %}>{{ block.settings.answer | escape | newline_to_br }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for faq in faq_fallback_items -%}
            {%- assign faq_parts = faq | split: '~' -%}
            <div class="border border-[#E5E0D4] overflow-hidden transition-all duration-200" data-tm-faq-item>
              <button type="button" data-tm-faq-q
                class="w-full p-4 sm:p-5 text-left bg-[#FAF9F5] hover:bg-[#F3F0E8] transition-colors flex items-center justify-between gap-4">
                <span class="font-serif text-base sm:text-lg font-bold text-[#0E233E]">{{ faq_parts[0] }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-tm-faq-icon
                  class="w-4 h-4 text-[#0E233E] shrink-0 transition-transform duration-200 {% if forloop.first %}rotate-180 text-[#C5222A]{% endif %}" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
              </button>
              <div data-tm-faq-a class="p-4 sm:p-5 bg-white text-xs sm:text-sm text-[#475569] leading-relaxed border-t border-[#E8E4DA]" {% unless forloop.first %}hidden{% endunless %}>{{ faq_parts[1] | strip | escape | newline_to_br }}</div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <!-- Show More Button -->
      <div class="mt-10 sm:mt-12 flex justify-center">
        <a href="{{ section.settings.more_link | default: '/pages/faq' }}"
          class="group inline-flex items-center justify-center gap-2.5 px-8 py-3.5 bg-[#0E233E] hover:bg-[#163359] text-white text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 shadow-sm hover:shadow">
          <span>Show More</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </section>
</div>

<script>
(function () {
  'use strict';

  function initRoot(root) {
    if (root.getAttribute('data-tm-init') === '1') return;
    root.setAttribute('data-tm-init', '1');

    /* Accordion: one item open at a time, like FaqSection.tsx */
    root.querySelectorAll('[data-tm-faq-q]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('[data-tm-faq-item]');
        if (!item) return;
        var answer = item.querySelector('[data-tm-faq-a]');
        var icon = item.querySelector('[data-tm-faq-icon]');
        var willOpen = answer.hidden;
        root.querySelectorAll('[data-tm-faq-item]').forEach(function (other) {
          other.querySelector('[data-tm-faq-a]').hidden = true;
          var otherIcon = other.querySelector('[data-tm-faq-icon]');
          if (otherIcon) otherIcon.classList.remove('rotate-180', 'text-[#C5222A]');
        });
        if (willOpen) {
          answer.hidden = false;
          if (icon) icon.classList.add('rotate-180', 'text-[#C5222A]');
        }
      });
    });
  }

  function initAll() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-tm-faq]'), initRoot);
  }

  document.addEventListener('shopify:section:load', function (e) {
    var root = document.getElementById('TmFaq-' + e.detail.sectionId);
    if (root) initRoot(root);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>

{% schema %}
{
  "name": "Trophy Mart FAQ",
  "settings": [
    {
      "type": "url",
      "id": "more_link",
      "label": "\"Show More\" link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Frequently asked question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Write the answer here."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Trophy Mart FAQ"
    }
  ]
}
{% endschema %}
