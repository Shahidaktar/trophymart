{%- assign root_id = 'TmFooter-' | append: section.id -%}

{%- capture type_fallback -%}Trophies;Medals & Badges;Plaques & Mementos;Cups & Shields{%- endcapture -%}
{%- assign type_fallback_items = type_fallback | split: ';' -%}
{%- capture occasion_fallback -%}Sports & Games;Education;Corporate Awards;Cultural & Community{%- endcapture -%}
{%- assign occasion_fallback_items = occasion_fallback | split: ';' -%}

<div class="tm-root" id="{{ root_id }}" data-tm-footer>
  <footer class="bg-[#F4F1EA] text-[#161C24] border-t border-[#E5E0D4]">

    <!-- Upper Main Footer Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">

        <!-- Brand Identity & Mission -->
        <div class="lg:col-span-4 order-1 space-y-4">
          <div class="flex items-center gap-3">
            {%- if section.settings.logo != blank -%}
              <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }} Logo" width="320" height="112" class="h-14 sm:h-16 w-auto object-contain p-1">
            {%- else -%}
              <img src="https://trophymart.co.in/wp-content/uploads/2024/07/TROPHY-MART-1-removebg-preview.png" alt="Trophy Mart Logo" width="256" height="80" referrerpolicy="no-referrer" onerror="this.style.display='none'" class="h-14 sm:h-16 w-auto object-contain p-1">
            {%- endif -%}
          </div>

          <p class="text-xs text-[#475569] leading-relaxed max-w-sm">{{ section.settings.brand_text }}</p>

          <div class="pt-2 text-xs space-y-2 text-[#334155]">
            {%- if section.settings.address != blank -%}
              <div class="flex items-start gap-2.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#C5222A] shrink-0 mt-0.5" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>{{ section.settings.address }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.phone != blank -%}
              <div class="flex items-center gap-2.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#C5222A] shrink-0" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                <span>{{ section.settings.phone }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <div class="flex items-center gap-2.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#C5222A] shrink-0" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                <span><a href="mailto:{{ section.settings.email }}" class="hover:text-[#C5222A] transition-colors">{{ section.settings.email }}</a></span>
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Quick Collections Navigation -->
        <div class="lg:col-span-3 order-3 space-y-3">
          <h4 class="font-serif text-lg font-bold text-[#0E233E] tracking-wide">Shop by Type</h4>
          <ul class="text-xs space-y-2 text-[#475569]">
            {%- if section.settings.type_menu != blank and section.settings.type_menu.links.size > 0 -%}
              {%- for link in section.settings.type_menu.links -%}
                <li><a href="{{ link.url }}" class="hover:text-[#C5222A] transition-colors">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for label in type_fallback_items -%}
                <li><a href="{{ routes.search_url }}?q={{ label | url_encode }}&amp;type=product" class="hover:text-[#C5222A] transition-colors">{{ label }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>

        <!-- Quick Links -->
        <div class="lg:col-span-2 order-2 space-y-3">
          <h4 class="font-serif text-lg font-bold text-[#0E233E] tracking-wide">Quick Links</h4>
          <ul class="text-xs space-y-2 text-[#475569]">
            {%- if section.settings.quick_menu != blank and section.settings.quick_menu.links.size > 0 -%}
              {%- for link in section.settings.quick_menu.links -%}
                <li><a href="{{ link.url }}" class="hover:text-[#C5222A] transition-colors">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="{{ section.settings.home_link | default: '/' }}" data-tm-scroll-top class="hover:text-[#C5222A] transition-colors">Home</a></li>
              <li><a href="{{ section.settings.about_link | default: '/pages/about' }}" data-tm-about class="hover:text-[#C5222A] transition-colors">About</a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="hover:text-[#C5222A] transition-colors">Products</a></li>
              <li><a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="hover:text-[#C5222A] transition-colors">Contact</a></li>
            {%- endif -%}
          </ul>
        </div>

        <!-- Shop by Occasion -->
        <div class="lg:col-span-3 order-4 space-y-3">
          <h4 class="font-serif text-lg font-bold text-[#0E233E] tracking-wide">Shop by Occasion</h4>
          <ul class="text-xs space-y-2 text-[#475569]">
            {%- if section.settings.occasion_menu != blank and section.settings.occasion_menu.links.size > 0 -%}
              {%- for link in section.settings.occasion_menu.links -%}
                <li><a href="{{ link.url }}" class="hover:text-[#C5222A] transition-colors text-left">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for label in occasion_fallback_items -%}
                <li><a href="{{ routes.search_url }}?q={{ label | url_encode }}&amp;type=product" class="hover:text-[#C5222A] transition-colors text-left">{{ label }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>

      </div>

      <!-- Bottom Legal / Copyright Bar -->
      <div class="mt-10 pt-6 border-t border-[#E5E0D4] flex flex-col sm:flex-row items-center justify-between text-xs text-[#64748B] gap-4">
        <div>{{ section.settings.copyright }}</div>
        <div class="flex items-center gap-6">
          {%- if section.settings.legal_menu != blank and section.settings.legal_menu.links.size > 0 -%}
            {%- for link in section.settings.legal_menu.links -%}
              <a href="{{ link.url }}" class="hover:text-[#C5222A] transition-colors">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="{{ shop.privacy_policy.url | default: '#' }}" class="hover:text-[#C5222A] transition-colors">Privacy Policy</a>
            <a href="{{ shop.terms_of_service.url | default: '#' }}" class="hover:text-[#C5222A] transition-colors">Terms of Commission</a>
            <a href="#" class="hover:text-[#C5222A] transition-colors">GST Compliance</a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </footer>
</div>

<script>
(function () {
  'use strict';

  function initRoot(root) {
    if (root.getAttribute('data-tm-init') === '1') return;
    root.setAttribute('data-tm-init', '1');

    /* Smooth-scroll helpers, same behaviour as Footer.tsx */
    root.querySelectorAll('[data-tm-scroll-top]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    root.querySelectorAll('[data-tm-about]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        var target = document.getElementById('about') || document.getElementById('craftsmanship');
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  }

  function initAll() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-tm-footer]'), initRoot);
  }

  document.addEventListener('shopify:section:load', function (e) {
    var root = document.getElementById('TmFooter-' + e.detail.sectionId);
    if (root) initRoot(root);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>

