@media (hover:hover){.hover\:bg-black\/70:hover{background-color:#000000b3}.hover\:bg-white\/80:hover{background-color:#ffffffcc}}
@media (min-width:640px){.sm\:aspect-auto{aspect-ratio:auto}.sm\:h-\[600px\]{height:600px}.sm\:hidden{display:none}.sm\:flex{display:flex}.sm\:scale-105{scale:105%}.sm\:scale-100{scale:100%}}

.tm-root * { box-sizing: border-box; }
.tm-root *::before, .tm-root *::after { box-sizing: inherit; }
:where(.tm-root) $1 { font: inherit; cursor: pointer; background: transparent; border: 0; padding: 0; -webkit-appearance: none; appearance: none; color: inherit; }
:where(.tm-root) $1 { display: block; max-width: none; }
.tm-root :focus-visible { outline: 2px solid #C5222A; outline-offset: 2px; border-radius: 2px; }
/* Slider controls: dots = desktop only (bottom-right), arrows = mobile only.
   Plain !important rules so no theme CSS can beat them (same pattern as the
   navbar's tm-desk / tm-mob switching). */
.tm-root .tm-hero-arrows { display: flex !important; }
.tm-root .tm-hero-dots { display: none !important; }
@media (min-width: 640px) {
  .tm-root .tm-hero-arrows { display: none !important; }
  .tm-root .tm-hero-dots { display: flex !important; }
}

/* Trap every hero layer (slides z-0/z-10, controls z-30) inside the hero's own
   stacking context, so they can never paint above the fixed header / mega
   menus or the bottom navigation, whatever the theme wrappers do. */
.tm-root [data-tm-slider] { isolation: isolate; }

/* Crossfade on desktop only. On mobile, animating two full-height portrait
   layers at once overwhelmed weak GPUs (page and fixed bottom nav flashed for
   a few ms on every transition), so slides switch instantly below 640px. */
.tm-root .tm-slide { transition: none; }
@media (min-width: 640px) {
  .tm-root .tm-slide { transition-property: opacity; transition-duration: 1s; transition-timing-function: cubic-bezier(.4, 0, .2, 1); }
}

.tm-root { font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #161C24; line-height: 1.4; }
</style>

{%- assign root_id = 'TmHero-' | append: section.id -%}
{%- assign fallback_web_1 = 'https://vrfacwizigigcpowkrye.supabase.co/storage/v1/object/public/trophy/aboutweb2.jpeg' -%}
{%- assign fallback_mob_1 = 'https://vrfacwizigigcpowkrye.supabase.co/storage/v1/object/public/trophy/aboutmobile2.jpeg' -%}
{%- assign fallback_web_2 = 'https://vrfacwizigigcpowkrye.supabase.co/storage/v1/object/public/trophy/a/trophy_mart_banner_1902x827%20(1).png' -%}
{%- assign fallback_mob_2 = 'https://vrfacwizigigcpowkrye.supabase.co/storage/v1/object/public/trophy/so%20make%20it%20for%20mobile%20screen%20size%20,%20dimensions%20is%20962%20x%201635.png' -%}
{%- assign slide_total = section.blocks.size -%}

<div class="tm-root" id="{{ root_id }}" data-tm-hero>
  <!-- Mobile: full banner at its actual 962x1635 aspect ratio; desktop: fixed 600px -->
  <section class="relative w-full aspect-[962/1635] sm:aspect-auto sm:h-[600px] overflow-hidden bg-[#070D18]" data-tm-slider>

    {%- if slide_total > 0 -%}
      {%- for block in section.blocks -%}
        <div class="tm-slide absolute inset-0 {% if forloop.first %}opacity-100 z-10{% else %}opacity-0 z-0 pointer-events-none{% endif %}"
          data-tm-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <picture>
            {%- if block.settings.mobile_image != blank -%}
              <source media="(max-width: 640px)" srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}">
            {%- else -%}
              <source media="(max-width: 640px)" srcset="{% cycle fallback_mob_1, fallback_mob_2 %}">
            {%- endif -%}
            <img
              src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2400 }}{% else %}{% cycle fallback_web_1, fallback_web_2 %}{% endif %}"
              alt="{{ block.settings.alt | escape }}"
              class="w-full h-full object-cover object-center transition-transform duration-[7000ms] ease-out {% if forloop.first %}sm:scale-105{% else %}sm:scale-100{% endif %}"
              decoding="async"
              {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          </picture>
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Built-in banners (used while no slide blocks are added) -->
      <div class="tm-slide absolute inset-0 opacity-100 z-10" data-tm-slide="0">
        <picture>
          <source media="(max-width: 640px)" srcset="{{ fallback_mob_1 }}">
          <img src="{{ fallback_web_1 }}" alt="Timeless Elegance Trophy Showcase"
            class="w-full h-full object-cover object-center transition-transform duration-[7000ms] ease-out sm:scale-105" decoding="async" loading="eager" fetchpriority="high">
        </picture>
      </div>
      <div class="tm-slide absolute inset-0 opacity-0 z-0 pointer-events-none" data-tm-slide="1">
        <picture>
          <source media="(max-width: 640px)" srcset="{{ fallback_mob_2 }}">
          <img src="{{ fallback_web_2 }}" alt="Championship Trophy Lights"
            class="w-full h-full object-cover object-center transition-transform duration-[7000ms] ease-out sm:scale-100" decoding="async" loading="lazy">
        </picture>
      </div>
      {%- assign slide_total = 2 -%}
    {%- endif -%}

    {%- if slide_total > 1 -%}
      <!-- Mobile: Left / Right arrow buttons (hidden on sm+) -->
      <button type="button" data-tm-prev aria-label="Previous slide"
        class="tm-hero-arrows sm:hidden absolute left-3 top-1/2 -translate-y-1/2 z-30 flex items-center justify-center w-9 h-9 rounded-full bg-black/50 backdrop-blur-md border border-white/15 text-white hover:bg-black/70 transition">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>
      <button type="button" data-tm-next aria-label="Next slide"
        class="tm-hero-arrows sm:hidden absolute right-3 top-1/2 -translate-y-1/2 z-30 flex items-center justify-center w-9 h-9 rounded-full bg-black/50 backdrop-blur-md border border-white/15 text-white hover:bg-black/70 transition">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>

      <!-- Desktop: Floating Vertical Slider Dots at bottom-right corner (hidden on mobile) -->
     <div class="tm-hero-dots hidden sm:flex absolute bottom-8 right-8 z-30 flex-col items-center gap-2 p-2 rounded-full"
     style="position:absolute; bottom:32px; right:32px; z-index:30; display:flex; flex-direction:column; align-items:center; gap:8px; padding:8px; border-radius:9999px; background:rgba(0,0,0,0.5); backdrop-filter:blur(12px); border:1px solid rgba(255,255,255,0.15); box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);">

  {%- for i in (1..slide_total) -%}
    {%- assign dot_index = i | minus: 1 -%}
    <button
      type="button"
      data-tm-dot="{{ dot_index }}"
      aria-label="Go to slide {{ i }}"
      style="width:10px; transition:all 300ms; border-radius:9999px; border:none; cursor:pointer; {% if forloop.first %}height:32px; background:#F30F18;{% else %}height:10px; background:rgba(255,255,255,0.4);{% endif %}">
    </button>
  {%- endfor -%}
</div>
    {%- endif -%}
  </section>
</div>

<script>
(function () {
  'use strict';

  var AUTO_MS = 5500; /* auto-advance every 5.5 seconds, like Hero.tsx */

  var registry = [];

  function initRoot(root) {
    if (root.getAttribute('data-tm-init') === '1') return;
    root.setAttribute('data-tm-init', '1');

    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-tm-slide]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-tm-dot]'));
    var total = slides.length;
    if (!total) return;
    var current = 0;
    var timer = null;

    function show(index) {
      current = (index + total) % total;
      slides.forEach(function (slide, i) {
        var img = slide.querySelector('img');
        if (i === current) {
          slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10');
          if (img) { img.classList.remove('sm:scale-100'); img.classList.add('sm:scale-105'); }
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
          if (img) { img.classList.add('sm:scale-100'); img.classList.remove('sm:scale-105'); }
        }
      });
      dots.forEach(function (dot, i) {
        /* dots are styled inline (class toggling can't beat inline styles) */
        if (i === current) {
          dot.style.height = '32px';
          dot.style.background = '#F30F18';
        } else {
          dot.style.height = '10px';
          dot.style.background = 'rgba(255,255,255,0.4)';
        }
      });
    }

    function startTimer() {
      timer = setInterval(function () { show(current + 1); }, AUTO_MS);
      registry.push({ root: root, timer: timer });
    }

    show(0);
    startTimer();

    Array.prototype.forEach.call(root.querySelectorAll('[data-tm-prev]'), function (el) {
      el.addEventListener('click', function () { show(current - 1); });
    });
    Array.prototype.forEach.call(root.querySelectorAll('[data-tm-next]'), function (el) {
      el.addEventListener('click', function () { show(current + 1); });
    });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        show(parseInt(dot.getAttribute('data-tm-dot'), 10) || 0);
      });
    });
  }

  function initAll() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-tm-hero]'), initRoot);
  }

  document.addEventListener('shopify:section:load', function (e) {
    var root = document.getElementById('TmHero-' + e.detail.sectionId);
    if (root) initRoot(root);
  });

  document.addEventListener('shopify:section:unload', function (e) {
    var id = 'TmHero-' + e.detail.sectionId;
    registry = registry.filter(function (entry) {
      if (entry.root.id === id || !entry.root.isConnected) {
        clearInterval(entry.timer);
        return false;
      }
      return true;
    });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>

