.relative{position:relative}.absolute{position:absolute}
.inset-0{inset:0}
.top-1\/2{top:50%}.left-3{left:calc(var(--spacing) * 3)}.right-3{right:calc(var(--spacing) * 3)}.bottom-8{bottom:calc(var(--spacing) * 8)}.right-8{right:calc(var(--spacing) * 8)}
.z-0{z-index:0}.z-10{z-index:10}.z-30{z-index:30}
.overflow-hidden{overflow:hidden}
.flex{display:flex}.hidden{display:none}.flex-col{flex-direction:column}
.items-center{align-items:center}.justify-center{justify-content:center}
.aspect-\[962\/1635\]{aspect-ratio:962/1635}
.w-full{width:100%}.h-full{height:100%}
.w-9{width:calc(var(--spacing) * 9)}.h-9{height:calc(var(--spacing) * 9)}.w-5{width:calc(var(--spacing) * 5)}.h-5{height:calc(var(--spacing) * 5)}.w-2\.5{width:calc(var(--spacing) * 2.5)}.h-2\.5{height:calc(var(--spacing) * 2.5)}.h-8{height:calc(var(--spacing) * 8)}
.gap-2{gap:calc(var(--spacing) * 2)}.p-2{padding:calc(var(--spacing) * 2)}
.-translate-y-1\/2{translate:0 -50%}
.scale-105{scale:105%}.scale-100{scale:100%}
.text-white{color:#fff}
.bg-\[\#070D18\]{background-color:#070d18}.bg-black\/50{background-color:#00000080}.bg-white\/40{background-color:#ffffff66}.bg-\[\#F30F18\]{background-color:#f30f18}
.border{border-style:solid;border-width:1px}.border-white\/15{border-color:#ffffff26}
.rounded-full{border-radius:2147483647px}
.object-cover{object-fit:cover}.object-center{object-position:center}
.shadow-2xl{box-shadow:0 25px 50px -12px #00000040}
.backdrop-blur-md{-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.opacity-0{opacity:0}.opacity-100{opacity:1}
