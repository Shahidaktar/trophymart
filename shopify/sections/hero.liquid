{
  "name": "Trophy Mart Hero",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image (> 640px)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image (â‰¤ 640px, portrait)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Trophy Mart banner"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Trophy Mart Hero",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "alt": "Timeless Elegance Trophy Showcase"
          }
        },
        {
          "type": "slide",
          "settings": {
            "alt": "Championship Trophy Lights"
          }
        },
        {
          "type": "slide",
          "settings": {
            "alt": "Championship Trophy Lights"
          }
        }
      ]
    }
  ]
}
{% endschema %}
