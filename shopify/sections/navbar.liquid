.tm-root * { box-sizing: border-box; }
.tm-root *::before, .tm-root *::after { box-sizing: inherit; }
:where(.tm-root) :is(h1, h2, h3, h4, h5, h6, p, ul, figure, blockquote) { margin: 0; padding: 0; }
:where(.tm-root) $1 { list-style: none; }
:where(.tm-root) $1 { font: inherit; cursor: pointer; background: transparent; border: 0; padding: 0; -webkit-appearance: none; appearance: none; }
:where(.tm-root) $1 { text-decoration: none; color: inherit; }
:where(.tm-root) $1 { display: block; max-width: none; }
:where(.tm-root) $1 { margin: 0; }
:where(.tm-root) $1 { font: inherit; color: inherit; width: 100%; min-width: 0; margin: 0; padding: 0; background: transparent; border: 0; box-shadow: none; outline: none; -webkit-appearance: none; appearance: none; border-radius: 0; }
:where(.tm-root) input::placeholder { color: #64748B; opacity: 1; }
.tm-root [hidden] { display: none !important; }
.tm-root :focus-visible { outline: 2px solid #C5222A; outline-offset: 2px; border-radius: 2px; }
.tm-root { font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #161C24; line-height: 1.4; }
@media (max-width: 767px) { body { padding-bottom: 72px; } }
/* Desktop / mobile switching - plain rules so no theme CSS can beat them */
.tm-root .tm-desk { display: none !important; }
.tm-root .tm-mob { display: flex !important; }
@media (min-width: 768px) {
  .tm-root .tm-desk { display: flex !important; }
  .tm-root .tm-mob { display: none !important; }
}

/* The explore drawer carries both .tm-mob and [hidden]. The flex rule above has
   the same specificity as ".tm-root [hidden]" and comes later in this
   stylesheet, so it defeated the hidden attribute: the drawer rendered open on
   page load and could never be closed (closeExplore only toggles hidden).
   Higher specificity here makes [hidden] win again. */
.tm-root .tm-mob[hidden] { display: none !important; }

/* Hover bridge for the desktop mega menus: the fixed panel starts at the
   header's bottom edge while the nav item's hover box ends at the button, so
   the pointer crossed a dead gap (header padding) and mouseleave closed the
   menu before anything could be clicked. Extend the item's hover area down
   to meet the panel. */
.tm-root [data-tm-menu]::after {
  content: "";
  position: absolute;
  top: 100%;
  left: -12px;
  right: -12px;
  height: 32px;
}

/* Keep the header and its fixed mega panels above every other section
   (e.g. the hero banner), whatever z-indexes the theme wrappers use. */
.tm-root #TmNav { z-index: 90 !important; }
.tm-root [data-tm-panel] { z-index: 91 !important; }

/* The explore drawer is a fullscreen modal: it must cover the header (z-90)
   and the bottom nav (z-50) while open - otherwise the site header paints
   over the drawer's own top bar and "Explore Catalog" / the close button
   disappear on mobile. */
.tm-root [data-tm-explore] { z-index: 95 !important; }


</style>

