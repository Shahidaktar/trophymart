            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
            <span>Back to Main Menu</span>
          </button>
          <h4 class="font-serif text-lg font-bold text-[#0E233E] border-b border-[#EAE6DF] pb-2 mb-3" style="padding-bottom:8px; margin-bottom:12px;font-size:18px;" >>Shop By Occasion</h4>
          <div class="space-y-2">
            {%- if occasion_menu != blank and occasion_menu.links.size > 0 -%}
              {%- for link in occasion_menu.links -%}{% if link.links.size > 0 %}
                <button type="button" data-tm-open-level3="occasion-{{ forloop.index }}" class="w-full flex items-center justify-between p-3.5 bg-[#FAF9F5] hover:bg-[#F3F0E8] border border-[#E5E0D4] rounded-md transition-all text-left group" style="padding:14px; background:#FAF9F5; hover-background:#F3F0E8; border:1px solid #E5E0D4; border-radius:6px;">
                  <span class="font-serif text-sm font-semibold text-[#0E233E] group-hover:text-[#C5222A] transition-colors">{{ link.title }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#64748B] group-hover:text-[#C5222A] group-hover:translate-x-0.5 transition-all shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                </button>
              {% endif %}{%- endfor -%}
            {%- else -%}
              {%- for group in occasion_groups -%}
                {%- assign group = group | strip -%}
                {%- assign parts = group | split: '|' -%}
                <button type="button" data-tm-open-level3="occasion-{{ forloop.index }}" class="w-full flex items-center justify-between p-3.5 bg-[#FAF9F5] hover:bg-[#F3F0E8] border border-[#E5E0D4] rounded-md transition-all text-left group" style="padding:14px; background:#FAF9F5; hover-background:#F3F0E8; border:1px solid #E5E0D4; border-radius:6px;">
                  <span class="font-serif text-sm font-semibold text-[#0E233E] group-hover:text-[#C5222A] transition-colors">{{ parts[0] }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#64748B] group-hover:text-[#C5222A] group-hover:translate-x-0.5 transition-all shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <!-- Level 3 â€” type cards -->
        <div class="absolute inset-0 flex flex-col overflow-y-auto p-4 transition-transform duration-300 ease-in-out bg-white translate-x-full" data-tm-level="3" data-tm-menu-panel="type">
          <button type="button" data-tm-back class="flex items-center gap-1.5 text-xs font-bold text-[#C5222A] hover:underline mb-3 py-1 self-start" style="font-size:12px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
            <span>Back to Types</span>
          </button>
          {%- if type_menu != blank and type_menu.links.size > 0 -%}
            {%- for link in type_menu.links -%}{% if link.links.size > 0 %}
              <h4 class="font-serif text-lg font-bold text-[#0E233E] border-b border-[#EAE6DF] pb-2 mb-3" style="padding-bottom:8px; margin-bottom:12px;" data-tm-level3-title="type-{{ forloop.index }}" hidden>{{ link.title }}</h4>
              <div class="grid grid-cols-2 gap-2.5 pb-6" data-tm-cards="type-{{ forloop.index }}" hidden>
                {%- for child in link.links -%}
                  {%- assign child_image = null -%}
                  {%- if child.object != blank -%}
                    {%- assign child_image = child.object.featured_image | default: child.object.image -%}
                  {%- endif -%}
                  <a class="group relative p-2.5 rounded-lg border text-left flex flex-col items-center justify-between transition-all duration-200 bg-[#FAF9F5] border-[#E5E0D4] hover:border-[#C5222A]/50 hover:bg-white hover:shadow-sm" href="{{ child.url }}">
                    <span class="w-full aspect-square rounded-md bg-[#F4F1EA] flex items-center justify-center  mb-2 group-hover:bg-[#FAF9F5] transition-colors overflow-hidden">
                      {%- if child_image != blank -%}
                        <img src="{{ child_image | image_url: width: 400 }}" alt="{{ child.title }}" width="400" height="400" loading="lazy" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110 drop-shadow-sm">
                      {%- else -%}
                        {{ ic_crystal }}
                      {%- endif -%}
                    </span>
                    <span class="text-[11px] font-medium text-[#0E233E] group-hover:text-[#C5222A] text-center line-clamp-2 leading-snug w-full">{{ child.title }}</span>
                  </a>
                {%- endfor -%}
              </div>
            {% endif %}{%- endfor -%}
          {%- else -%}
            {%- for group in type_groups -%}
              {%- assign group = group | strip -%}
              {%- assign parts = group | split: '|' -%}
              {%- assign group_cat = parts[1] -%}
              {%- assign tm_items = parts[2] | split: '^' -%}
              <h4 class="font-serif text-lg font-bold text-[#0E233E] border-b border-[#EAE6DF] pb-2 mb-3" data-tm-level3-title="type-{{ forloop.index }}" hidden>{{ parts[0] }}</h4>
              <div class="grid grid-cols-2 gap-2.5 pb-6" data-tm-cards="type-{{ forloop.index }}" hidden>
                {%- for item in tm_items -%}
                  {%- assign item_bits = item | strip | split: '@' -%}
                  {%- assign item_label = item_bits[0] -%}
                  {%- assign item_cat = group_cat -%}
                  {%- if item_bits.size > 1 -%}{%- assign item_cat = item_bits[1] -%}{%- endif -%}
                  {%- liquid
                    case item_cat
                      when 'gold'
                        assign item_icon = ic_gold
                      when 'plaques'
                        assign item_icon = ic_plaques
                      when 'medals'
                        assign item_icon = ic_medals
                      when 'bespoke'
                        assign item_icon = ic_bespoke
                      else
                        assign item_icon = ic_crystal
                    endcase
                  -%}
                  <a class="group relative p-2.5 rounded-lg border text-left flex flex-col items-center justify-between transition-all duration-200 bg-[#FAF9F5] border-[#E5E0D4] hover:border-[#C5222A]/50 hover:bg-white hover:shadow-sm" href="{{ routes.search_url }}?q={{ item_label | url_encode }}&amp;type=product">
                    <span class="w-full aspect-square rounded-md bg-[#F4F1EA] flex items-center justify-center p-2 mb-2 group-hover:bg-[#FAF9F5] transition-colors overflow-hidden">
                      {{ item_icon }}
                    </span>
                    <span class="text-[11px] font-medium text-[#0E233E] group-hover:text-[#C5222A] text-center line-clamp-2 leading-snug w-full">{{ item_label }}</span>
                  </a>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <!-- Level 3 â€” occasion cards -->
        <div class="absolute inset-0 flex flex-col overflow-y-auto p-4 transition-transform duration-300 ease-in-out bg-white translate-x-full" data-tm-level="3" data-tm-menu-panel="occasion">
          <button type="button" data-tm-back class="flex items-center gap-1.5 text-xs font-bold text-[#C5222A] hover:underline mb-3 py-1 self-start" style="font-size:12px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
            <span>Back to Occasions</span>
          </button>
          {%- if occasion_menu != blank and occasion_menu.links.size > 0 -%}
            {%- for link in occasion_menu.links -%}{% if link.links.size > 0 %}
              <h4 class="font-serif text-lg font-bold text-[#0E233E] border-b border-[#EAE6DF] pb-2 mb-3" style="padding-bottom:8px; margin-bottom:12px;" data-tm-level3-title="occasion-{{ forloop.index }}" hidden>{{ link.title }}</h4>
              <div class="grid grid-cols-2 gap-2.5 pb-6" data-tm-cards="occasion-{{ forloop.index }}" hidden>
                {%- for child in link.links -%}
                  {%- assign child_image = null -%}
                  {%- if child.object != blank -%}
                    {%- assign child_image = child.object.featured_image | default: child.object.image -%}
                  {%- endif -%}
                  <a class="group relative p-2.5 rounded-lg border text-left flex flex-col items-center justify-between transition-all duration-200 bg-[#FAF9F5] border-[#E5E0D4] hover:border-[#C5222A]/50 hover:bg-white hover:shadow-sm" href="{{ child.url }}">
                    <span class="w-full aspect-square rounded-md bg-[#F4F1EA] flex items-center justify-center  mb-2 group-hover:bg-[#FAF9F5] transition-colors overflow-hidden">
                      {%- if child_image != blank -%}
                        <img src="{{ child_image | image_url: width: 400 }}" alt="{{ child.title }}" width="400" height="400" loading="lazy" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110 drop-shadow-sm">
                      {%- else -%}
                        {{ ic_crystal }}
                      {%- endif -%}
                    </span>
                    <span class="text-[11px] font-medium text-[#0E233E] group-hover:text-[#C5222A] text-center line-clamp-2 leading-snug w-full">{{ child.title }}</span>
                  </a>
                {%- endfor -%}
              </div>
            {% endif %}{%- endfor -%}
          {%- else -%}
            {%- for group in occasion_groups -%}
              {%- assign group = group | strip -%}
              {%- assign parts = group | split: '|' -%}
              {%- assign group_cat = parts[1] -%}
              {%- assign tm_items = parts[2] | split: '^' -%}
              <h4 class="font-serif text-lg font-bold text-[#0E233E] border-b border-[#EAE6DF] pb-2 mb-3" data-tm-level3-title="occasion-{{ forloop.index }}" hidden>{{ parts[0] }}</h4>
              <div class="grid grid-cols-2 gap-2.5 pb-6" data-tm-cards="occasion-{{ forloop.index }}" hidden>
                {%- for item in tm_items -%}
                  {%- assign item_bits = item | strip | split: '@' -%}
                  {%- assign item_label = item_bits[0] -%}
                  {%- assign item_cat = group_cat -%}
                  {%- if item_bits.size > 1 -%}{%- assign item_cat = item_bits[1] -%}{%- endif -%}
                  {%- liquid
                    case item_cat
                      when 'gold'
                        assign item_icon = ic_gold
                      when 'plaques'
                        assign item_icon = ic_plaques
                      when 'medals'
                        assign item_icon = ic_medals
                      when 'bespoke'
                        assign item_icon = ic_bespoke
                      else
                        assign item_icon = ic_crystal
                    endcase
                  -%}
                  <a class="group relative p-2.5 rounded-lg border text-left flex flex-col items-center justify-between transition-all duration-200 bg-[#FAF9F5] border-[#E5E0D4] hover:border-[#C5222A]/50 hover:bg-white hover:shadow-sm" href="{{ routes.search_url }}?q={{ item_label | url_encode }}&amp;type=product">
                    <span class="w-full aspect-square rounded-md bg-[#F4F1EA] flex items-center justify-center p-2 mb-2 group-hover:bg-[#FAF9F5] transition-colors overflow-hidden">
                      {{ item_icon }}
                    </span>
                    <span class="text-[11px] font-medium text-[#0E233E] group-hover:text-[#C5222A] text-center line-clamp-2 leading-snug w-full">{{ item_label }}</span>
                  </a>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var PHRASES = ['Search trophies...', 'Search crystal awards...', 'Search championship cups...', 'Search bespoke plaques...', 'Search sports medals...'];

  function toggleClasses(el, add, remove) {
    if (!el) return;
    if (add) add.forEach(function (c) { el.classList.add(c); });
    if (remove) remove.forEach(function (c) { el.classList.remove(c); });
  }

  function initRoot(root) {
    if (root.getAttribute('data-tm-init') === '1') return;
    root.setAttribute('data-tm-init', '1');

    var nav = root.querySelector('#TmNav');

    /* Keep --tm-header-h in sync with this instance's header height */
    function setHeaderHeight() {
      if (nav) root.style.setProperty('--tm-header-h', nav.offsetHeight + 'px');
    }
    setHeaderHeight();
    window.addEventListener('resize', setHeaderHeight);
    if (typeof ResizeObserver !== 'undefined' && nav) {
      new ResizeObserver(setHeaderHeight).observe(nav);
    }

    /* ---------- Desktop mega menus (hover + click, one at a time) ---------- */
    var drops = Array.prototype.slice.call(root.querySelectorAll('[data-tm-menu]'));

    function panelFor(drop) {
      return root.querySelector('[data-tm-panel="' + drop.getAttribute('data-tm-menu') + '"]');
    }
    function chevronFor(drop) {
      return drop.querySelector('[data-tm-toggle] svg');
    }

    function openMenu(drop) {
      drops.forEach(function (d) { if (d !== drop) closeMenu(d); });
      var panel = panelFor(drop);
      var btn = drop.querySelector('[data-tm-toggle]');
      if (panel) panel.hidden = false;
      if (btn) btn.setAttribute('aria-expanded', 'true');
      var chev = chevronFor(drop);
      if (chev) chev.classList.add('rotate-180');
    }

    function closeMenu(drop) {
      var panel = panelFor(drop);
      var btn = drop.querySelector('[data-tm-toggle]');
      if (panel) panel.hidden = true;
      if (btn) btn.setAttribute('aria-expanded', 'false');
      var chev = chevronFor(drop);
      if (chev) chev.classList.remove('rotate-180');
    }

    function closeAllMenus() { drops.forEach(closeMenu); }

    /* Delay the hover-close slightly so the pointer can travel from the nav
       item into the fixed panel without the menu closing en route. */
    var closeTimer = null;
    function cancelClose() {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    }

    drops.forEach(function (drop) {
      var btn = drop.querySelector('[data-tm-toggle]');
      var panel = panelFor(drop);
      if (panel) panel.addEventListener('mouseenter', cancelClose);
      drop.addEventListener('mouseenter', function () { cancelClose(); openMenu(drop); });
      drop.addEventListener('mouseleave', function () {
        cancelClose();
        closeTimer = setTimeout(function () { closeMenu(drop); }, 180);
      });
      if (btn) {
        btn.addEventListener('click', function () {
          var panel = panelFor(drop);
          if (panel && !panel.hidden) { closeMenu(drop); } else { openMenu(drop); }
        });
      }
    });

    document.addEventListener('mousedown', function (e) {
      var drop = e.target.closest && e.target.closest('[data-tm-menu]');
      if (drop && root.contains(drop)) return;
      closeAllMenus();
    });

    /* ---------- Explore drawer ---------- */
    var explore = root.querySelector('[data-tm-explore]');
    var level1 = explore ? explore.querySelector('[data-tm-level="1"]') : null;
    var activeMenu = null;

    var previousOverflow = document.body.style.overflow;

    function showLevel1() {
      activeMenu = null;
      toggleClasses(level1, ['translate-x-0'], ['-translate-x-full']);
      levels('2').forEach(function (panel) { toggleClasses(panel, ['translate-x-full'], ['translate-x-0', '-translate-x-full']); });
      levels('3').forEach(function (panel) { toggleClasses(panel, ['translate-x-full'], ['translate-x-0']); });
      setBottomActive('explore');
    }

    function levels(name) {
      return explore ? Array.prototype.slice.call(explore.querySelectorAll('[data-tm-level="' + name + '"]')) : [];
    }

    function showLevel2(menu) {
      activeMenu = menu;
      toggleClasses(level1, ['-translate-x-full'], null);
      levels('2').forEach(function (panel) {
        if (panel.getAttribute('data-tm-menu-panel') === menu) {
          toggleClasses(panel, ['translate-x-0'], ['translate-x-full', '-translate-x-full']);
        } else {
          toggleClasses(panel, ['translate-x-full'], ['translate-x-0', '-translate-x-full']);
        }
      });
      levels('3').forEach(function (panel) { toggleClasses(panel, ['translate-x-full'], ['translate-x-0']); });
    }

    function showLevel3(key) {
      levels('3').forEach(function (panel) {
        if (panel.getAttribute('data-tm-menu-panel') === activeMenu) {
          toggleClasses(panel, ['translate-x-0'], ['translate-x-full']);
          /* slide the level-2 panel out behind it, as the React drawer does */
          levels('2').forEach(function (l2) {
            if (l2.getAttribute('data-tm-menu-panel') === activeMenu) {
              toggleClasses(l2, ['-translate-x-full'], ['translate-x-0', 'translate-x-full']);
            }
          });
        } else {
          toggleClasses(panel, ['translate-x-full'], ['translate-x-0']);
        }
      });
      explore.querySelectorAll('[data-tm-cards], [data-tm-level3-title]').forEach(function (el) {
        var gridKey = el.getAttribute('data-tm-cards') || el.getAttribute('data-tm-level3-title');
        el.hidden = (gridKey !== key);
      });
    }

    function openExplore() {
      if (!explore) return;
      explore.hidden = false;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      showLevel1();
    }

    function closeExplore() {
      if (!explore || explore.hidden) return;
      explore.hidden = true;
      document.body.style.overflow = previousOverflow;
      setBottomActive('home');
    }

    function unlockScroll() {
      if (explore && !explore.hidden) {
        explore.hidden = true;
        document.body.style.overflow = previousOverflow;
      }
    }

    if (explore) {
      explore.querySelectorAll('[data-tm-open-level2]').forEach(function (btn) {
        btn.addEventListener('click', function () { showLevel2(btn.getAttribute('data-tm-open-level2')); });
      });
      explore.querySelectorAll('[data-tm-open-level3]').forEach(function (btn) {
        btn.addEventListener('click', function () { showLevel3(btn.getAttribute('data-tm-open-level3')); });
      });
      explore.querySelectorAll('[data-tm-back]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var level = btn.closest('[data-tm-level]');
          if (!level) return;
          if (level.getAttribute('data-tm-level') === '3') {
            toggleClasses(level, ['translate-x-full'], ['translate-x-0']);
            showLevel2(activeMenu);
          } else {
            showLevel1();
          }
        });
      });
      explore.querySelectorAll('[data-tm-close-explore]').forEach(function (btn) {
        btn.addEventListener('click', closeExplore);
      });
      explore.querySelectorAll('[data-tm-cards], [data-tm-level3-title]').forEach(function (el) { el.hidden = true; });
    }

    /* ---------- Mobile bottom navigation ---------- */
    var bottomButtons = Array.prototype.slice.call(root.querySelectorAll('[data-tm-bottom]'));
    var bottomClasses = {
      active: ['text-[#C5222A]', 'font-bold'],
      idle: ['text-[#0E233E]', 'hover:text-[#C5222A]']
    };

    function setBottomActive(name) {
      bottomButtons.forEach(function (b) {
        var active = b.getAttribute('data-tm-bottom') === name;
        if (active) {
          toggleClasses(b, bottomClasses.active, bottomClasses.idle);
        } else {
          toggleClasses(b, bottomClasses.idle, bottomClasses.active);
        }
      });
    }

    bottomButtons.forEach(function (b) {
      b.addEventListener('click', function () {
        var target = b.getAttribute('data-tm-bottom');
        if (target === 'explore') {
          openExplore();
        } else if (target === 'about') {
          scrollToAbout();
          setBottomActive('about');
        } else if (target === 'contact') {
          closeAllMenus();
          unlockScroll();
          setBottomActive('contact');
          window.location.href = {{ section.settings.contact_link | default: '/pages/contact' | json }};
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
          closeAllMenus();
          unlockScroll();
          setBottomActive('home');
        }
      });
    });

    /* ---------- Header link helpers ---------- */
    function aboutTarget() {
      return document.getElementById('craftsmanship') || document.getElementById('about');
    }

    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      closeAllMenus();
      unlockScroll();
    }

    function scrollToAbout() {
      var elem = aboutTarget();
      if (elem) {
        elem.scrollIntoView({ behavior: 'smooth' });
        closeAllMenus();
        unlockScroll();
      } else {
        window.location.href = {{ section.settings.about_link | default: '/pages/about' | json }};
      }
    }

    root.querySelectorAll('[data-tm-scroll-top]').forEach(function (el) {
      el.addEventListener('click', function () { scrollToTop(); });
    });

    root.querySelectorAll('[data-tm-about]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        if (aboutTarget()) {
          e.preventDefault();
          scrollToAbout();
        }
      });
    });

    root.querySelectorAll('[data-tm-contact]').forEach(function (el) {
      el.addEventListener('click', function () {
        closeAllMenus();
        unlockScroll();
      });
    });

    /* ---------- Rotating search placeholder ---------- */
    var inputs = Array.prototype.slice.call(root.querySelectorAll('[data-tm-phrase]'));
    var phraseIndex = 0;
    var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (inputs.length && !prefersReducedMotion) {
      window.setInterval(function () {
        var animatable = inputs.filter(function (el) { return el.value === ''; });
        if (!animatable.length) return;
        animatable.forEach(function (el) { el.classList.add('opacity-0', '-translate-y-2'); });
        window.setTimeout(function () {
          phraseIndex = (phraseIndex + 1) % PHRASES.length;
          animatable.forEach(function (el) {
            el.placeholder = PHRASES[phraseIndex];
            el.classList.remove('opacity-0', '-translate-y-2');
          });
        }, 300);
      }, 2800);
    }

    /* ---------- Live cart badge ---------- */
    var badge = root.querySelector('[data-tm-cart-count]');

    function setCartCount(count) {
      if (!badge) return;
      badge.textContent = String(count);
      badge.hidden = count <= 0;
    }

    function refreshCart() {
      fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (cart) { setCartCount(cart.item_count); })
        .catch(function () {});
    }

    document.addEventListener('cart:update', function (e) {
      var cart = e && e.detail && e.detail.cart;
      if (cart && typeof cart.item_count === 'number') { setCartCount(cart.item_count); }
      else { refreshCart(); }
    });
    document.addEventListener('product:added', refreshCart);

    /* ---------- Escape closes every overlay in this instance ---------- */
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (explore && !explore.hidden) { closeExplore(); }
      closeAllMenus();
    });

    /* Let the theme editor re-render this section with working controls */
    root.setAttribute('data-tm-unload-handler', '1');
    window.tmNavUnlock = window.tmNavUnlock || [];
    window.tmNavUnlock.push(unlockScroll);
  }

  function initAll() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-tm-root]'), initRoot);
  }

  document.addEventListener('shopify:section:load', function (e) {
    var root = document.getElementById('TmNav-' + e.detail.sectionId);
    if (root) initRoot(root);
  });

  document.addEventListener('shopify:section:unload', function () {
    /* A re-rendered section can leave the drawer scroll-lock on the body */
    (window.tmNavUnlock || []).forEach(function (fn) { fn(); });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>

