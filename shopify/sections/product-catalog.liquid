{%- assign root_id = 'TmProd-' | append: section.id -%}
{%- if section.settings.collection != blank -%}
  {%- assign tm_collection = section.settings.collection -%}
{%- else -%}
  {%- assign tm_collection = collections.all -%}
{%- endif -%}

<div class="tm-root" id="{{ root_id }}" data-tm-prod>
  <section id="catalog" class="py-16 sm:py-20 bg-[#FAF9F5] border-b border-[#E8E4DA]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Heading -->
      <div class="relative z-20 flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 sm:mb-8">
        <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight text-[#0E233E] leading-[1.02] lg:whitespace-nowrap">
          Find Your <span class="italic text-[#C5222A]">Perfect Trophy</span>
        </h2>

        <div class="flex items-center gap-2 shrink-0">
          <button type="button" data-tm-prod-prev aria-label="Previous products"
            class="w-9 h-9 sm:w-10 sm:h-10 border border-[#0E233E]/25 bg-white flex items-center justify-center text-[#0E233E] transition-colors hover:bg-[#0E233E] hover:text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button type="button" data-tm-prod-next aria-label="Next products"
            class="w-9 h-9 sm:w-10 sm:h-10 border border-[#0E233E]/25 bg-white flex items-center justify-center text-[#0E233E] transition-colors hover:bg-[#0E233E] hover:text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
      </div>

      <!-- Cards Slider -->
      {%- if tm_collection.products.size > 0 -%}
        <div class="no-scrollbar flex gap-3 sm:gap-5 xl:gap-7 overflow-x-auto snap-x snap-mandatory scroll-smooth" data-tm-track>
          {%- for product in tm_collection.products limit: 8 -%}
            <a href="{{ product.url }}" aria-label="{{ product.title | escape }}"
              class="group relative snap-start shrink-0 w-[calc(50%-0.375rem)] sm:w-[calc(33.333%-0.833rem)] lg:w-[calc(25%-0.9375rem)] text-left">
              <!-- Product image (portrait 3:4, no background layer) -->
              <div class="relative aspect-[3/4] overflow-hidden">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 1024px) 22vw, 40vw"
                    alt="{{ product.title | escape }}" loading="lazy" decoding="async" draggable="false"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                {%- else -%}
                  <span class="w-full h-full flex items-center justify-center">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#B98A2E" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-1/3 h-1/3" aria-hidden="true"><path d="M8 21h8"></path><path d="M12 21v-6"></path><path d="M7 3h10v6a5 5 0 0 1-10 0V3Z"></path><path d="M7 5H4v2a3 3 0 0 0 3 3"></path><path d="M17 5h3v2a3 3 0 0 1-3 3"></path></svg>
                  </span>
                {%- endif -%}
              </div>

              <!-- Product name below the image -->
              <h3 class="mt-4 text-center font-serif text-[13px] sm:text-sm lg:text-base xl:text-lg font-bold text-[#0E233E] leading-snug line-clamp-2">{{ product.title }}</h3>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="py-20 text-center">
          <p class="text-sm text-[#64748B]">No products in this category.</p>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

<script>
(function () {
  'use strict';

  var AUTO_MS = 3500;
  var registry = [];

  function attachTrack(root, track) {
    var paused = false;
    var visible = true;
    var timer = null;

    function step() {
      var first = track.firstElementChild;
      var gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
      return (first ? first.offsetWidth : 300) + gap;
    }

    function advance() {
      if (paused || !visible) return;
      var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      track.scrollTo({ left: atEnd ? 0 : track.scrollLeft + step(), behavior: 'smooth' });
    }

    function scrollSlider(direction) {
      track.scrollBy({ left: direction * step(), behavior: 'smooth' });
    }

    var prev = root.querySelector('[data-tm-prod-prev]');
    var next = root.querySelector('[data-tm-prod-next]');
    if (prev) prev.addEventListener('click', function () { scrollSlider(-1); });
    if (next) next.addEventListener('click', function () { scrollSlider(1); });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    timer = window.setInterval(advance, AUTO_MS);
    registry.push({ root: root, timer: timer, track: track });

    track.addEventListener('pointerenter', function () { paused = true; });
    track.addEventListener('pointerleave', function () { paused = false; });
    track.addEventListener('touchstart', function () { paused = true; }, { passive: true });
    track.addEventListener('touchend', function () { paused = false; });

    if (typeof IntersectionObserver !== 'undefined') {
      var observer = new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting;
      }, { threshold: 0.25 });
      observer.observe(track);
      registry.push({ root: root, timer: null, observer: observer });
    }
  }

  function initRoot(root) {
    if (root.getAttribute('data-tm-init') === '1') return;
    root.setAttribute('data-tm-init', '1');
    var track = root.querySelector('[data-tm-track]');
    if (track) attachTrack(root, track);
  }

  function initAll() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-tm-prod]'), initRoot);
  }

  document.addEventListener('shopify:section:load', function (e) {
    var root = document.getElementById('TmProd-' + e.detail.sectionId);
    if (root) initRoot(root);
  });

  document.addEventListener('shopify:section:unload', function (e) {
    var id = 'TmProd-' + e.detail.sectionId;
    registry = registry.filter(function (entry) {
      if (entry.root.id === id || !entry.root.isConnected) {
        if (entry.timer) window.clearInterval(entry.timer);
        if (entry.observer) entry.observer.disconnect();
        return false;
      }
      return true;
    });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>

{% schema %}
{
  "name": "Trophy Mart Product Catalog",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (default: all products)"
    }
  ],
  "presets": [
    {
      "name": "Trophy Mart Product Catalog"
    }
  ]
}
{% endschema %}
