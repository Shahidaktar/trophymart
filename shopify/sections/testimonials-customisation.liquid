:where(.tm-root) :is(h1, h2, h3, h4, h5, h6, p, ul, figure, blockquote) { margin: 0; padding: 0; }
:where(.tm-root) a { text-decoration: none; color: inherit; }
:where(.tm-root) img { display: block; max-width: none; }
:where(.tm-root) button { font: inherit; cursor: pointer; background: transparent; border: 0; padding: 0; -webkit-appearance: none; appearance: none; color: inherit; }
.tm-root :focus-visible { outline: 2px solid #C5222A; outline-offset: 2px; border-radius: 2px; }
.tm-root { font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #161C24; line-height: 1.4; }

/* Responsive layout: stack on small screens, show side-by-side on desktop/tablet */
.tm-root .testimonials-grid {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) !important;
  gap: 32px !important;
  align-items: stretch !important;
  width: 100%;
}

@media screen and (min-width: 768px) {
  .tm-root .testimonials-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    column-gap: 64px !important;
    row-gap: 32px !important;
  }
}

/* The dividers must follow the same 768px breakpoint as the grid, otherwise
   the horizontal divider renders as a grid child on tablets and pushes the
   right column into a second row. */
.tm-root .tm-divider-h { display: flex; }
@media screen and (min-width: 768px) {
  .tm-root .tm-divider-h { display: none !important; }
}
.tm-root .tm-divider-v { display: none; }
@media screen and (min-width: 768px) {
  .tm-root .tm-divider-v { display: flex; }
}

/* Both headings reserve the same 2-line height so the two cards start at the
   same top edge and stretch to the same size (columns are equal via the grid). */
.tm-root .tm-head { min-height: 2.8em; }
</style>

