<div class="tm-root" id="{{ root_id }}" data-tm-testi-root>
  <section id="clients" class="relative overflow-hidden bg-[#070D18] border-y border-white/10 py-12 sm:py-20 lg:py-24">
    <img
      src="{% if tm_bg != blank %}{{ tm_bg | image_url: width: 2000 }}{% else %}https://trophymart.co.in/wp-content/uploads/2024/07/AdobeStock_734878397-scaled-1.jpeg{% endif %}"
      alt="" aria-hidden="true" loading="lazy" decoding="async" referrerpolicy="no-referrer"
      class="absolute inset-0 h-full w-full object-cover object-center opacity-40">
    <div class="absolute inset-0 bg-[#070D18]/80"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#070D18] via-[#070D18]/60 to-[#070D18]/30"></div>
    <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#DFB967]/80 to-transparent"></span>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Vertical divider between the two cards (desktop) -->
      <div aria-hidden="true" class="tm-divider-v absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[85%] w-px flex-col items-center justify-center">
        <span class="flex-1 w-px bg-gradient-to-b from-transparent via-white/20 to-[#DFB967]/25"></span>
        <span class="my-4 block h-2 w-2 rotate-45 bg-[#DFB967]/90 shrink-0"></span>
        <span class="flex-1 w-px bg-gradient-to-t from-transparent via-white/20 to-[#DFB967]/25"></span>
      </div>

      <div class="testimonials-grid grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-stretch">

        <!-- Left Column: Testimonials Carousel -->
        <div class="flex flex-col h-full" data-tm-testi-wrap>
          <h2 class="tm-head font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white">
            Reflections of
            <span class="italic text-[#DFB967]">our craftsmanship.</span>
          </h2>

          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.quote != blank -%}
                <div class="relative w-full flex-1 overflow-hidden border border-white/10 bg-[#070D18]/60 backdrop-blur-sm p-5 sm:p-9 flex flex-col justify-between mt-6 sm:mt-10" data-tm-testi {{ block.shopify_attributes }} {% unless forloop.first %}hidden{% endunless %}>
                  {{ quote_icon }}
                  <div>
                    <div class="flex text-amber-400 gap-0.5 mb-3 sm:mb-4">
                      {%- assign stars = block.settings.rating | default: 5 -%}
                      {%- for i in (1..stars) -%}{{ star_svg }}{%- endfor -%}
                    </div>
                    <blockquote class="font-serif text-sm sm:text-base text-white/85 leading-relaxed italic min-h-[5.5rem] sm:min-h-[7rem]">"{{ block.settings.quote }}"</blockquote>
                  </div>
                  <div class="pt-4 sm:pt-5 mt-4 sm:mt-5 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                      <div class="font-serif text-sm sm:text-base font-bold text-white">{{ block.settings.name }}</div>
                      <div class="text-[11px] text-[#DFB967] font-medium">{{ block.settings.designation }}</div>
                      <div class="text-[11px] text-white/55">{{ block.settings.organization }} &middot; {{ block.settings.city }}</div>
                    </div>
                    <div class="flex shrink-0 self-end sm:self-auto gap-2">{{ prev_arrow }}{{ next_arrow }}</div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for t in testi_fallback_items -%}
              {%- assign tp = t | split: '~' -%}
              <div class="relative w-full flex-1 overflow-hidden border border-white/10 bg-[#070D18]/60 backdrop-blur-sm p-5 sm:p-9 flex flex-col justify-between mt-6 sm:mt-10" data-tm-testi {% unless forloop.first %}hidden{% endunless %}>
                {{ quote_icon }}
                <div>
                  <div class="flex text-amber-400 gap-0.5 mb-3 sm:mb-4">
                    {%- assign stars = tp[4] | strip | plus: 0 -%}
                    {%- for i in (1..stars) -%}{{ star_svg }}{%- endfor -%}
                  </div>
                  <blockquote class="text-sm sm:text-base text-white/85 leading-relaxed italic min-h-[5.5rem] sm:min-h-[7rem]">"{{ tp[5] | strip }}"</blockquote>
                </div>
                <div class="pt-4 sm:pt-5 mt-4 sm:mt-5 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <div class="font-serif text-sm sm:text-base font-bold text-white">{{ tp[0] }}</div>
                    <div class="text-[11px] text-[#DFB967] font-medium">{{ tp[1] }}</div>
                    <div class="text-[11px] text-white/55">{{ tp[2] }} &middot; {{ tp[3] }}</div>
                  </div>
                  <div class="flex shrink-0 self-end sm:self-auto gap-2">{{ prev_arrow }}{{ next_arrow }}</div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <!-- Horizontal divider between the cards (mobile / tablet) -->
        <div aria-hidden="true" class="tm-divider-h flex items-center gap-3">
          <span class="h-px flex-1 bg-gradient-to-r from-transparent via-white/20 to-[#DFB967]/25"></span>
          <span class="h-2 w-2 rotate-45 bg-[#DFB967]/90 shrink-0"></span>
          <span class="h-px flex-1 bg-gradient-to-r from-[#DFB967]/25 via-white/20 to-transparent"></span>
        </div>

        <!-- Right Column: Bespoke Customisation Card -->
        <div class="flex flex-col h-full">
          <h2 class="tm-head font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white">
            Want to customise
            <br>
            <span class="italic text-[#DFB967]">your own trophy?</span>
          </h2>

          <div class="relative w-full flex-1 overflow-hidden border border-white/10 bg-[#070D18]/60 backdrop-blur-sm p-5 sm:p-9 flex flex-col justify-between mt-6 sm:mt-10 items-center text-center">
            <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#DFB967]/80 to-transparent"></span>

            <div class="my-auto">
              <p class="text-sm sm:text-base text-white/65 leading-relaxed">{{ section.settings.cta_text }}</p>
            </div>

            <div class="mt-6 sm:mt-8 flex flex-wrap items-center justify-center gap-3">
              <a href="{{ section.settings.cta_link | default: '/pages/contact' }}"
                class="group inline-flex items-center justify-center gap-2 bg-[#DFB967] px-6 py-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#070D18] transition-colors hover:bg-[#F0D08A]">
                <span>{{ section.settings.cta_label }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</div>

<script>
(function () {
  'use strict';

  var AUTO_MS = 6000;
  var registry = [];

  function initRoot(root) {
    if (root.getAttribute('data-tm-init') === '1') return;
    root.setAttribute('data-tm-init', '1');

    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-tm-testi]'));
    if (!cards.length) return;
    var current = 0;
    var paused = false;
    var timer = null;

    function show(index) {
      current = (index + cards.length) % cards.length;
      cards.forEach(function (card, i) {
        card.hidden = (i !== current);
      });
    }

    function goTo(index) { show(index); }

    show(0);

    Array.prototype.forEach.call(root.querySelectorAll('[data-tm-prev]'), function (el) {
      el.addEventListener('click', function () { goTo(current - 1); });
    });
    Array.prototype.forEach.call(root.querySelectorAll('[data-tm-next]'), function (el) {
      el.addEventListener('click', function () { goTo(current + 1); });
    });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var wrap = root.querySelector('[data-tm-testi-wrap]');
    if (wrap) {
      wrap.addEventListener('pointerenter', function () { paused = true; });
      wrap.addEventListener('pointerleave', function () { paused = false; });
    }

    timer = window.setInterval(function () {
      if (!paused) show(current + 1);
    }, AUTO_MS);
    registry.push({ root: root, timer: timer });
  }

  function initAll() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-tm-testi-root]'), initRoot);
  }

  document.addEventListener('shopify:section:load', function (e) {
    var root = document.getElementById('TmTesti-' + e.detail.sectionId);
    if (root) initRoot(root);
  });

  document.addEventListener('shopify:section:unload', function (e) {
    var id = 'TmTesti-' + e.detail.sectionId;
    registry = registry.filter(function (entry) {
      if (entry.root.id === id || !entry.root.isConnected) {
        if (entry.timer) window.clearInterval(entry.timer);
        return false;
      }
      return true;
    });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>

